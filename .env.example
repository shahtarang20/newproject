# ---------- Core ----------
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/vastra
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# ---------- Auth ----------
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=

# ---------- Storage (STORAGE_PROVIDER: local | cloudinary | s3 | r2) ----------
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=

# ---------- Payments (PAYMENT_PROVIDER: razorpay | stripe | none) ----------
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Notifications ----------
WHATSAPP_PROVIDER=none
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=Vastra <no-reply@example.com>

# ---------- Seed / demo (dev only, never commit real values) ----------
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=
SEED_SHOP_OWNER_EMAIL=owner@example.com
SEED_SHOP_OWNER_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=

# Placeholder image host used by the seed script (images are generated URLs, nothing is uploaded)
SEED_IMAGE_BASE=https://picsum.photos/seed
